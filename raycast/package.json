{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "firefox-cli-tabs",
  "title": "Firefox Tabs",
  "description": "Search, switch to, and close open Firefox tabs via the CLI Tabs extension.",
  "icon": "extension-icon.png",
  "author": "brendanjcaffrey",
  "owner": "jcaffrey",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search-tabs",
      "title": "Search Firefox Tabs",
      "description": "Search open Firefox tabs and switch to or close them.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "1.104.0",
    "@raycast/utils": "^2.3.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  }
}
